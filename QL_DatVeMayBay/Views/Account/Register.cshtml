@model QL_DatVeMayBay.Models.RegisterForm
@{
    ViewData["Title"] = "Đăng ký tài khoản hành khách";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card card-modern p-4 p-md-5">
                <h1 class="h4 fw-bold mb-3">Đăng ký thành viên SkyVN Airlines</h1>
                <form method="post" asp-action="Register">
                    <div asp-validation-summary="All" class="text-danger small" role="alert"></div>
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="tenKH" class="form-label small fw-semibold">Họ và tên *</label>
                            <input id="tenKH" type="text" name="tenKH" class="form-control" value="@Model.TenKH"
                                   autocomplete="name" maxlength="50" required />
                        </div>
                        <div class="col-md-3">
                            <label for="gioiTinh" class="form-label small fw-semibold">Giới tính *</label>
                            <select id="gioiTinh" name="gioiTinh" class="form-select">
                                <option value="Nam" selected="@(Model.GioiTinh == "Nam")">Nam</option>
                                <option value="Nữ" selected="@(Model.GioiTinh == "Nữ")">Nữ</option>
                                <option value="Khác" selected="@(Model.GioiTinh == "Khác")">Khác</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="ngaySinh" class="form-label small fw-semibold">Ngày sinh *</label>
                            <input id="ngaySinh" type="date" name="ngaySinh" class="form-control"
                                   value="@(Model.NgaySinh?.ToString("yyyy-MM-dd"))" max="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   autocomplete="bday" required />
                        </div>
                        <div class="col-md-6">
                            <label for="sdt" class="form-label small fw-semibold">Số điện thoại *</label>
                            <input id="sdt" type="tel" name="sdt" class="form-control" value="@Model.Sdt"
                                   autocomplete="tel" required />
                        </div>
                        <div class="col-md-6">
                            <label for="email" class="form-label small fw-semibold">Email *</label>
                            <input id="email" type="email" name="email" class="form-control" value="@Model.Email"
                                   autocomplete="email" autocapitalize="none" spellcheck="false" maxlength="100" required />
                        </div>
                        <div class="col-md-4">
                            <label for="loaiKhachHang" class="form-label small fw-semibold">Đối tượng khách *</label>
                            <select id="loaiKhachHang" name="loaiKhachHang" class="form-select">
                                <option value="Việt Nam" selected="@(Model.LoaiKhachHang == "Việt Nam")">Việt Nam</option>
                                <option value="Nước ngoài" selected="@(Model.LoaiKhachHang == "Nước ngoài")">Nước ngoài</option>
                                <option value="Doanh nghiệp" selected="@(Model.LoaiKhachHang == "Doanh nghiệp")">Doanh nghiệp</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="cccd" class="form-label small fw-semibold">CCCD (tùy chọn)</label>
                            <input id="cccd" type="text" name="cccd" class="form-control" value="@Model.Cccd"
                                   inputmode="numeric" maxlength="12" pattern="[0-9]{12}" placeholder="12 chữ số" />
                        </div>
                        <div class="col-md-4">
                            <label for="hoChieu" class="form-label small fw-semibold">Hộ chiếu (tùy chọn)</label>
                            <input id="hoChieu" type="text" name="hoChieu" class="form-control" value="@Model.HoChieu" maxlength="30" />
                        </div>
                        <div class="col-md-4">
                            <label for="quocTich" class="form-label small fw-semibold">Quốc tịch (tùy chọn)</label>
                            <input id="quocTich" type="text" name="quocTich" class="form-control" value="@Model.QuocTich" maxlength="50" />
                        </div>
                        <div class="col-md-8">
                            <label for="diaChi" class="form-label small fw-semibold">Địa chỉ liên hệ (tùy chọn)</label>
                            <input id="diaChi" type="text" name="diaChi" class="form-control" value="@Model.DiaChi"
                                   autocomplete="street-address" maxlength="200" />
                        </div>
                        <div class="col-12">
                            <label for="matKhau" class="form-label small fw-semibold">Mật khẩu *</label>
                            <div class="input-group">
                                <input id="matKhau" type="password" name="matKhau" class="form-control" autocomplete="new-password"
                                       minlength="6" maxlength="128" aria-describedby="passwordHelp" autocapitalize="none" spellcheck="false" required />
                                <button type="button" class="btn btn-outline-secondary" data-password-toggle
                                        aria-label="Hiện hoặc ẩn mật khẩu" aria-controls="matKhau" aria-pressed="false">Hiện</button>
                            </div>
                            <div id="passwordHelp" class="form-text">Nhập từ 6 đến 128 ký tự.</div>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-sky w-100 py-2 rounded-pill mt-4">Hoàn tất đăng ký</button>
                </form>
                <p class="small mt-3 mb-0"><a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Quay lại đăng nhập</a></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/password-toggle.js" asp-append-version="true"></script>
}
