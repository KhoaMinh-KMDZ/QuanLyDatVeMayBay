@using System.Data
@using QRCoder
@{
    ViewData["Title"] = "Check-in Trực tuyến & Thẻ lên máy bay";
    var dtVes = ViewBag.DanhSachVe as DataTable;
}

<div class="container my-5">
    <div class="row justify-content-center mb-4">
        <div class="col-lg-8">
            <div class="card card-modern p-4">
                <h4 class="fw-bold mb-2"><i class="bi bi-qr-code-scan text-primary me-2"></i>Làm thủ tục Check-in trực tuyến (UC07)</h4>
                <p class="text-muted small mb-3">Nhập mã đặt chỗ (PNR) và họ tên hành khách để nhận Thẻ lên máy bay điện tử (Boarding Pass).</p>
                <form method="get" asp-action="Index" class="row g-2">
                    <div class="col-md-5">
                        <input type="text" name="maDatCho" maxlength="15" aria-label="Mã đặt chỗ" class="form-control form-control-lg" placeholder="Mã PNR (VD: PNR00001)" value="@Context.Request.Query["maDatCho"]" required />
                    </div>
                    <div class="col-md-5">
                        <input type="text" name="tenHanhKhach" maxlength="50" aria-label="Họ tên hành khách" class="form-control form-control-lg" placeholder="Họ tên đầy đủ của hành khách" value="@Context.Request.Query["tenHanhKhach"]" required />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-sky btn-lg w-100">Tìm vé</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-warning text-center">@ViewBag.Error</div>
    }

    @if (dtVes != null)
    {
        foreach (DataRow v in dtVes.Rows)
        {
            string maVe = v["MaVe"].ToString()!;
            string trangThai = v["TrangThaiVe"].ToString()!;
            DateTime gioBay = Convert.ToDateTime(v["NgayGioBay"]);
            DateTime boardingTime = gioBay.AddMinutes(-30);

            if (trangThai == "Đã Check-in")
            {
                <!-- THẺ LÊN MÁY BAY ĐIỆN TỬ (BOARDING PASS - UC15) -->
                <div class="card card-modern overflow-hidden mb-4 border border-primary">
                    <div class="bg-primary text-white px-4 py-3 d-flex justify-content-between align-items-center">
                        <div class="fw-bold fs-5"><i class="bi bi-airplane-fill me-2"></i>@v["HangBay"] — BOARDING PASS</div>
                        <span class="badge bg-warning text-dark">THẺ LÊN MÁY BAY ĐIỆN TỬ</span>
                    </div>
                    <div class="card-body p-4">
                        <div class="row align-items-center g-4">
                            <div class="col-md-8 border-end-md">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="small text-muted">HÀNH KHÁCH / PASSENGER</div>
                                        <div class="fs-5 fw-bold text-uppercase">@v["TenHanhKhach"]</div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="small text-muted">MÃ VÉ / E-TICKET</div>
                                        <div class="fs-5 fw-bold text-primary">@maVe</div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="small text-muted">TỪ / FROM</div>
                                        <div class="fw-bold">@v["ThanhPhoDi"]</div>
                                        <div class="small text-muted">@v["SanBayDi"]</div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="small text-muted">ĐẾN / TO</div>
                                        <div class="fw-bold">@v["ThanhPhoDen"]</div>
                                        <div class="small text-muted">@v["SanBayDen"]</div>
                                    </div>
                                    <div class="col-4">
                                        <div class="small text-muted">CHUYẾN BAY</div>
                                        <div class="fs-5 fw-bold text-danger">@v["MaChuyenBay"]</div>
                                    </div>
                                    <div class="col-4">
                                        <div class="small text-muted">GIỜ LÊN TÀU</div>
                                        <div class="fs-5 fw-bold text-danger">@boardingTime.ToString("HH:mm")</div>
                                    </div>
                                    <div class="col-4">
                                        <div class="small text-muted">GHẾ / HẠNG</div>
                                        <div class="fs-5 fw-bold text-success">@v["SoGhe"] <span class="fs-6 text-muted">(@v["TenHangGhe"])</span></div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 text-center">
                                @{
                                    using var qrData = QRCodeGenerator.GenerateQrCode($"BP-{v["MaChuyenBay"]}-{maVe}", QRCodeGenerator.ECCLevel.M);
                                    using var qrCode = new PngByteQRCode(qrData);
                                    string qrImage = Convert.ToBase64String(qrCode.GetGraphic(5));
                                }
                                <img src="data:image/png;base64,@qrImage" alt="Mã QR thẻ lên máy bay mẫu" class="img-fluid mb-2 border p-2 rounded" />
                                <div class="small">Thẻ mẫu · Cửa khởi hành do hãng thông báo</div>
                                <button type="button" class="btn btn-outline-primary btn-sm mt-2 d-print-none" onclick="window.print()">In thẻ</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card card-modern p-4 mb-3">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div>
                            <span class="badge bg-dark me-1">@maVe</span>
                            <span class="badge bg-info text-dark">@trangThai</span>
                            <h6 class="fw-bold mt-2 mb-1">@v["TenHanhKhach"] — Ghế @v["SoGhe"] (@v["TenHangGhe"])</h6>
                            <div class="small text-muted">Chuyến @v["MaChuyenBay"]: @v["ThanhPhoDi"] → @v["ThanhPhoDen"] • Khởi hành: @gioBay.ToString("HH:mm dd/MM/yyyy")</div>
                        </div>
                        @if (trangThai == "Đã xuất vé" && Convert.ToInt32(v["CoTheCheckIn"]) == 1)
                        {
                            <form method="post" asp-action="ConfirmCheckIn">
                                <input type="hidden" name="maVe" value="@maVe" />
                                <input type="hidden" name="maDatCho" value="@v["MaDatCho"]" />
                                <input type="hidden" name="tenHanhKhach" value="@Context.Request.Query["tenHanhKhach"]" />
                                <label class="form-check mb-2">
                                    <input type="checkbox" name="chapNhanAnToan" value="true" required class="form-check-input" />
                                    Tôi đồng ý tuân thủ quy định về hành lý và vật phẩm nguy hiểm.
                                </label>
                                <button type="submit" class="btn btn-success rounded-pill px-4">
                                    <i class="bi bi-check2-circle me-1"></i>Xác nhận Check-in & In thẻ
                                </button>
                            </form>
                        }
                        else if (trangThai == "Đã xuất vé")
                        {
                            <span class="small text-muted">Check-in trong khoảng 24 giờ đến 60 phút trước giờ khởi hành.</span>
                        }
                    </div>
                </div>
            }
        }
    }
</div>