@model QL_DatVeMayBay.Models.PromoForm
@{
    ViewData["Title"] = "Chỉnh sửa khuyến mãi";
}
<div class="container my-5">
    @if (TempData["Error"] is string error)
    {
        <p class="alert alert-warning">@error</p>
    }
    <h1 class="h3">@ViewData["Title"] <span class="text-muted">@Model.MaKM</span></h1>
    <form method="post" asp-action="Promotion" class="card p-4 mt-3">
        <div asp-validation-summary="All" class="text-danger"></div>
        <input asp-for="MaKM" type="hidden" />
        <input asp-for="OriginalUses" type="hidden" />
        <div class="row g-3">
            <label class="col-md-6">Tên chương trình <input asp-for="TenKM" class="form-control" /></label>
            <label class="col-md-6">Mức giảm (%) <input asp-for="PhanTramGiam" type="number" min="0" max="100" step="0.01" class="form-control" /></label>
            <label class="col-md-6">Giảm tối đa (VNĐ) <input asp-for="GiamToiDa" type="number" min="0" class="form-control" /></label>
            <label class="col-md-6">Giá trị đơn tối thiểu (VNĐ) <input asp-for="DonHangToiThieu" type="number" min="0" class="form-control" /></label>
            <label class="col-md-4">Ngày bắt đầu <input asp-for="NgayBatDau" class="form-control" /></label>
            <label class="col-md-4">Ngày kết thúc <input asp-for="NgayKetThuc" class="form-control" /></label>
            <label class="col-md-4">Số lượt còn khả dụng <input asp-for="SoLuong" min="0" class="form-control" /></label>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button class="btn btn-primary" type="submit">Lưu khuyến mãi</button>
            <a class="btn btn-outline-secondary" asp-action="Dashboard" asp-fragment="tab-promos">Quay lại</a>
        </div>
    </form>
</div>
