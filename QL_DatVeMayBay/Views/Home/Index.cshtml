@using System.Data
@model DataTable
@{
    ViewData["Title"] = "Đặt vé máy bay nội địa Việt Nam";
    var sanBays = ViewBag.SanBays as DataTable;
    var hangs = ViewBag.HangHangKhongs as DataTable;
    var hangGhes = ViewBag.HangGhes as DataTable;
    var diemDungs = ViewBag.DiemDung as DataTable;
    string selectedHangGhe = ViewBag.SelectedHangGhe ?? "ECO";
}

<section class="py-5 text-white" style="background: linear-gradient(135deg, #0f172a 0%, #0369a1 100%);">
    <div class="container py-3">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-warning text-dark fw-semibold px-3 py-2 rounded-pill mb-3">
                    <i class="bi bi-stars me-1"></i>Mạng lưới 15 Cảng Hàng Không Nội Địa Việt Nam
                </span>
                <h1 class="display-5 fw-bold mb-3">Khám phá Việt Nam trên từng chuyến bay</h1>
                <p class="lead text-light opacity-75 mb-0">
                    Đặt vé trực tuyến nhanh chóng • Khóa ghế thời gian thực • Xuất thẻ lên máy bay QR tức thì.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Hộp Tìm Kiếm Chuyến Bay -->
<div class="container" style="margin-top: -40px;">
    <div class="card card-modern p-4">
        <form method="get" asp-controller="Home" asp-action="Index">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-semibold small text-secondary"><i class="bi bi-geo-alt-fill text-primary me-1"></i>Điểm khởi hành</label>
                    <select name="maSanBayDi" class="form-select form-select-lg fs-6" required>
                        @if (sanBays != null)
                        {
                            foreach (DataRow sb in sanBays.Rows)
                            {
                                string code = sb["MaSanBay"].ToString()!;
                                <option value="@code" selected="@(code == (string)ViewBag.SelectedDi)">
                                    @sb["ThanhPho"] (@code) - @sb["TenSanBay"]
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold small text-secondary"><i class="bi bi-geo-fill text-danger me-1"></i>Điểm đến</label>
                    <select name="maSanBayDen" class="form-select form-select-lg fs-6" required>
                        @if (sanBays != null)
                        {
                            foreach (DataRow sb in sanBays.Rows)
                            {
                                string code = sb["MaSanBay"].ToString()!;
                                <option value="@code" selected="@(code == (string)ViewBag.SelectedDen)">
                                    @sb["ThanhPho"] (@code) - @sb["TenSanBay"]
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-semibold small text-secondary"><i class="bi bi-calendar-event me-1"></i>Ngày bay</label>
                    <input type="date" name="ngayBay" class="form-control form-control-lg fs-6" value="@ViewBag.SelectedNgay" required />
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-semibold small text-secondary"><i class="bi bi-award me-1"></i>Hạng ghế</label>
                    <select name="maHangGhe" class="form-select form-select-lg fs-6">
                        @if (hangGhes != null)
                        {
                            foreach (DataRow hg in hangGhes.Rows)
                            {
                                string code = hg["MaHangGhe"].ToString()!;
                                <option value="@code" selected="@(code == selectedHangGhe)">
                                    @hg["TenHangGhe"] (x@hg["HeSoGia"])
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <button type="submit" class="btn btn-sky btn-lg w-100 fs-6 py-2">
                        <i class="bi bi-search me-1"></i>Tìm chuyến
                    </button>
                </div>
            </div>

            <!-- Bộ lọc mở rộng -->
            <div class="row g-3 mt-2 pt-2 border-top align-items-center">
                <div class="col-md-3">
                    <select name="maHang" class="form-select form-select-sm">
                        <option value="">-- Tất cả hãng hàng không --</option>
                        @if (hangs != null)
                        {
                            foreach (DataRow h in hangs.Rows)
                            {
                                string code = h["MaHang"].ToString()!;
                                <option value="@code" selected="@(code == (string)ViewBag.SelectedHang)">@h["TenHang"]</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <input type="number" name="giaMax" class="form-control form-control-sm" placeholder="Giá cơ bản tối đa (VNĐ)..." value="@ViewBag.SelectedGiaMax" step="100000" />
                </div>
                <div class="col-md-6 text-md-end small text-muted">
                    Gợi ý dữ liệu mẫu: <strong>SGN → HAN (01/09/2026)</strong>, <strong>SGN → DAD (01/09/2026)</strong>, <strong>HPH → VCS (05/09/2026 - Quá cảnh)</strong>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Danh sách Kết quả Chuyến bay -->
<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0">
            @if (ViewBag.DaTimKiem == true)
            {
                <span><i class="bi bi-airplane text-primary me-2"></i>Kết quả tìm kiếm (@Model.Rows.Count chuyến bay)</span>
            }
            else
            {
                <span><i class="bi bi-fire text-danger me-2"></i>Các chuyến bay nội địa đang mở bán</span>
            }
        </h4>
    </div>

    @if (Model.Rows.Count == 0)
    {
        <div class="card card-modern p-5 text-center">
            <i class="bi bi-calendar-x display-4 text-muted mb-3"></i>
            <h5 class="fw-bold">Không tìm thấy chuyến bay phù hợp</h5>
            <p class="text-muted">Vui lòng thử chọn ngày bay khác (ví dụ: 01/09/2026 đến 06/09/2026) hoặc bỏ bớt bộ lọc giá.</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (DataRow row in Model.Rows)
            {
                string maCB = row["MaChuyenBay"].ToString()!;
                DateTime gioBay = Convert.ToDateTime(row["NgayGioBay"]);
                DateTime gioDen = Convert.ToDateTime(row["NgayGioDenDK"]);
                decimal giaCoBan = Convert.ToDecimal(row["GiaVeCoBan"]);

                // Kiểm tra điểm dừng quá cảnh
                DataRow[] transits = diemDungs?.Select($"MaChuyenBay = '{maCB}'") ?? Array.Empty<DataRow>();

                <div class="col-12">
                    <div class="card card-modern p-4">
                        <div class="row align-items-center g-3">
                            <!-- Hãng & Số hiệu -->
                            <div class="col-md-3">
                                <span class="badge bg-primary-subtle text-primary fw-bold mb-1">@maCB</span>
                                <h6 class="fw-bold mb-1">@row["TenHang"]</h6>
                                <div class="small text-muted"><i class="bi bi-airplane me-1"></i>@row["TenMayBay"]</div>
                            </div>

                            <!-- Hành trình & Thời gian -->
                            <div class="col-md-5">
                                <div class="d-flex align-items-center justify-content-between text-center">
                                    <div>
                                        <div class="fs-4 fw-bold">@gioBay.ToString("HH:mm")</div>
                                        <div class="small fw-semibold text-secondary">@row["ThanhPhoDi"]</div>
                                        <div class="text-muted" style="font-size: 0.75rem;">@gioBay.ToString("dd/MM/yyyy")</div>
                                    </div>

                                    <div class="flex-grow-1 px-3">
                                        <div class="small text-muted mb-1">@row["ThoiGianBay"] phút</div>
                                        <div class="border-top border-2 border-primary position-relative my-2">
                                            <i class="bi bi-airplane-fill text-primary position-absolute top-50 start-50 translate-middle bg-white px-2"></i>
                                        </div>
                                        @if (transits.Length > 0)
                                        {
                                            <span class="badge bg-warning-subtle text-dark" style="font-size: 0.7rem;">
                                                1 điểm dừng tại @transits[0]["ThanhPho"] (@transits[0]["ThoiGianDung"]p)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-success fw-semibold" style="font-size: 0.75rem;">Bay thẳng</span>
                                        }
                                    </div>

                                    <div>
                                        <div class="fs-4 fw-bold">@gioDen.ToString("HH:mm")</div>
                                        <div class="small fw-semibold text-secondary">@row["ThanhPhoDen"]</div>
                                        <div class="text-muted" style="font-size: 0.75rem;">@gioDen.ToString("dd/MM/yyyy")</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Giá vé & Nút đặt -->
                            <div class="col-md-4 text-md-end border-start-md ps-md-4">
                                <div class="small text-muted">Giá vé cơ bản từ</div>
                                <div class="fs-4 fw-bold text-danger mb-1">@giaCoBan.ToString("N0") VNĐ</div>
                                <div class="small text-success mb-3">
                                    <i class="bi bi-person-check-fill me-1"></i>Còn <strong>@row["SoGheTrong"]</strong> ghế trống
                                </div>
                                <a asp-controller="Booking" asp-action="SelectSeats"
                                   asp-route-maChuyenBay="@maCB"
                                   asp-route-maHangGhe="@selectedHangGhe"
                                   class="btn btn-sky px-4 rounded-pill">
                                    Chọn ghế & Đặt vé <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>