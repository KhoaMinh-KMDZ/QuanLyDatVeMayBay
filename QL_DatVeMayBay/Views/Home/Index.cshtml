@{
    ViewData["Title"] = "Đặt Vé Máy Bay Trực Tuyến";
    var sanBays = ViewBag.SanBays as List<dynamic> ?? new();
    var lichBay = ViewBag.LichChuyenBay as List<Dictionary<string, object>> ?? new();
    var lichBayVe = ViewBag.LichChuyenBayVe as List<Dictionary<string, object>> ?? new();
    bool isRoundTrip = ViewBag.LoaiHanhTrinh == "KHU_HOI";
    bool daLoc = ViewBag.DaLoc == true;
}

<div class="container py-4">
    <!-- BỘ LỌC TÌM KIẾM CHUYẾN BAY -->
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden mb-5">
        <div class="card-header bg-danger text-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">✈ TÌM KIẾM CHUYẾN BAY</h5>
            <div class="btn-group" role="group">
                <input type="radio" class="btn-check" name="tripRadio" id="radOneWay" @(!isRoundTrip ? "checked" : "") onclick="toggleRoundTrip(false)">
                <label class="btn btn-outline-light btn-sm fw-semibold" for="radOneWay">Một chiều</label>

                <input type="radio" class="btn-check" name="tripRadio" id="radRoundTrip" @(isRoundTrip ? "checked" : "") onclick="toggleRoundTrip(true)">
                <label class="btn btn-outline-light btn-sm fw-semibold" for="radRoundTrip">Khứ hồi</label>
            </div>
        </div>

        <form method="get" asp-action="Index" class="card-body p-4 bg-white">
            <input type="hidden" name="loaiHanhTrinh" id="loaiHanhTrinhInput" value="@ViewBag.LoaiHanhTrinh" />
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted">ĐIỂM KHỞI HÀNH</label>
                    <select name="maSanBayDi" class="form-select form-select-lg">
                        @foreach (var sb in sanBays)
                        {
                            <option value="@sb.MaSanBay" selected="@(sb.MaSanBay == ViewBag.MaSanBayDi)">@sb.ThanhPho (@sb.MaSanBay)</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted">ĐIỂM ĐẾN</label>
                    <select name="maSanBayDen" class="form-select form-select-lg">
                        @foreach (var sb in sanBays)
                        {
                            <option value="@sb.MaSanBay" selected="@(sb.MaSanBay == ViewBag.MaSanBayDen)">@sb.ThanhPho (@sb.MaSanBay)</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold small text-muted">NGÀY ĐI</label>
                    <input type="date" name="ngayDi" value="@ViewBag.NgayDi" class="form-control form-control-lg" />
                </div>
                <div class="col-md-2" id="ngayVeCol" style="display:@(isRoundTrip ? "block" : "none")">
                    <label class="form-label fw-bold small text-muted">NGÀY VỀ</label>
                    <input type="date" name="ngayVe" value="@ViewBag.NgayVe" class="form-control form-control-lg" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold small text-muted">LOẠI CHUYẾN</label>
                    <select name="cheDoBay" class="form-select form-select-lg">
                        <option value="ALL" selected="@(ViewBag.CheDoBay == "ALL")">Tất cả chuyến</option>
                        <option value="THANG" selected="@(ViewBag.CheDoBay == "THANG")">Bay thẳng</option>
                        <option value="QUA_CANH" selected="@(ViewBag.CheDoBay == "QUA_CANH")">Bay quá cảnh</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold small text-muted">HÀNH KHÁCH</label>
                    <select name="soHanhKhach" class="form-select form-select-lg">
                        @for (int i = 1; i <= 4; i++)
                        {
                            <option value="@i" selected="@(ViewBag.SoHanhKhach == i)">@i Hành khách</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-warning btn-lg w-100 fw-bold shadow-sm">Tìm chuyến</button>
                </div>
            </div>
        </form>
    </div>

    <!-- TIÊU ĐỀ & NÚT XÓA BỘ LỌC -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0">
            @(daLoc
                        ? (isRoundTrip ? $"Lịch chuyến bay Lượt đi ({lichBay.Count} chuyến)" : $"Lịch chuyến bay phù hợp ({lichBay.Count} chuyến)")
                        : "Lịch chuyến bay đang mở bán")
        </h4>
        @if (daLoc)
        {
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                ✕ Xóa bộ lọc (Xem tất cả)
            </a>
        }
    </div>

    <!-- DANH SÁCH THẺ CHUYẾN BAY (MỘT CHIỀU HOẶC LƯỢT ĐI KHỨ HỒI) -->
    @if (lichBay.Count == 0)
    {
        <div class="alert alert-warning rounded-4 p-4 text-center mb-4">
            Không tìm thấy chuyến bay nào khớp với điều kiện lọc hiện tại. Bạn có thể đổi ngày bay hoặc bấm <strong>"Xóa bộ lọc"</strong> để xem toàn bộ lịch bay.
        </div>
    }
    else
    {
        <div class="row g-4 mb-4">
            @foreach (var item in lichBay)
            {
                bool isTransit = Convert.ToInt32(item["LaChuyenQuaCanh"]) == 1;
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden">
                        <div class="position-relative" style="height: 165px;">
                            <img src="@item["HinhAnhDiemDen"]" class="w-100 h-100 object-fit-cover" alt="@item["ThanhPhoDen"]" />
                            <span class="position-absolute top-0 start-0 m-2 badge bg-dark bg-opacity-75">
                                @item["MaChuyenBay"] • @item["TenHangHangKhong"]
                            </span>
                            <span class="position-absolute top-0 end-0 m-2 badge @(isTransit ? "bg-warning text-dark" : "bg-success")">
                                @(isTransit ? "Chuyến quá cảnh" : "Bay thẳng")
                            </span>
                            <div class="position-absolute bottom-0 start-0 end-0 p-2 text-white" style="background: linear-gradient(transparent, rgba(0,0,0,0.8));">
                                <strong>@item["ThanhPhoDi"] (@item["MaSanBayDi"]) → @item["ThanhPhoDen"] (@item["MaSanBayDen"])</strong>
                            </div>
                        </div>
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <div class="small text-muted mb-1">
                                    🕒 Khởi hành: <strong>@Convert.ToDateTime(item["NgayGioBay"]).ToString("dd/MM/yyyy HH:mm")</strong>
                                </div>
                                @if (isTransit)
                                {
                                    <div class="alert alert-warning py-1 px-2 small mb-2">
                                        🔄 <strong>Điểm dừng:</strong> @item["ThongTinQuaCanh"]
                                    </div>
                                }
                                <div class="small text-success fw-semibold">Còn @item["SoGheTrong"] ghế trống</div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center border-top pt-3 mt-3">
                                <div>
                                    <small class="text-muted d-block">Chi phí từ</small>
                                    <span class="fs-5 fw-bold text-danger">@Convert.ToDecimal(item["GiaVeCoBan"]).ToString("N0") VNĐ</span>
                                </div>
                                @if (isRoundTrip)
                                {
                                    <div>
                                        <input type="radio" class="btn-check" name="selectedDi" id="di_@item["MaChuyenBay"]" value="@item["MaChuyenBay"]" onchange="updateRoundTripBar()">
                                        <label class="btn btn-outline-danger fw-bold rounded-pill px-3" for="di_@item["MaChuyenBay"]">Chọn lượt đi</label>
                                    </div>
                                }
                                else
                                {
                                    <a asp-controller="Booking" asp-action="SelectSeats"
                                       asp-route-maChuyenBayDi="@item["MaChuyenBay"]"
                                       asp-route-soHanhKhach="@ViewBag.SoHanhKhach"
                                       class="btn btn-danger fw-bold rounded-pill px-3">Đặt vé</a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- NẾU ĐANG LỌC KHỨ HỒI -> HIỂN THỊ THÊM LỊCH CHUYẾN BAY LƯỢT VỀ BÊN DƯỚI -->
    @if (daLoc && isRoundTrip)
    {
        <h4 class="fw-bold mb-3 mt-4 text-primary">Lịch chuyến bay Lượt về (@lichBayVe.Count chuyến)</h4>
        @if (lichBayVe.Count == 0)
        {
            <div class="alert alert-warning rounded-4 p-4 text-center">
                Không có chuyến bay lượt về vào ngày @ViewBag.NgayVe. Hãy thử chọn ngày về khác.
            </div>
        }
        else
        {
            <div class="row g-4 mb-4">
                @foreach (var item in lichBayVe)
                {
                    bool isTransit = Convert.ToInt32(item["LaChuyenQuaCanh"]) == 1;
                    <div class="col-md-4">
                        <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden">
                            <div class="position-relative" style="height: 165px;">
                                <img src="@item["HinhAnhDiemDen"]" class="w-100 h-100 object-fit-cover" alt="@item["ThanhPhoDen"]" />
                                <span class="position-absolute top-0 start-0 m-2 badge bg-dark bg-opacity-75">
                                    @item["MaChuyenBay"] • @item["TenHangHangKhong"]
                                </span>
                                <span class="position-absolute top-0 end-0 m-2 badge @(isTransit ? "bg-warning text-dark" : "bg-success")">
                                    @(isTransit ? "Chuyến quá cảnh" : "Bay thẳng")
                                </span>
                                <div class="position-absolute bottom-0 start-0 end-0 p-2 text-white" style="background: linear-gradient(transparent, rgba(0,0,0,0.8));">
                                    <strong>@item["ThanhPhoDi"] (@item["MaSanBayDi"]) → @item["ThanhPhoDen"] (@item["MaSanBayDen"])</strong>
                                </div>
                            </div>
                            <div class="card-body d-flex flex-column justify-content-between">
                                <div>
                                    <div class="small text-muted mb-1">
                                        🕒 Khởi hành: <strong>@Convert.ToDateTime(item["NgayGioBay"]).ToString("dd/MM/yyyy HH:mm")</strong>
                                    </div>
                                    @if (isTransit)
                                    {
                                        <div class="alert alert-warning py-1 px-2 small mb-2">
                                            🔄 <strong>Điểm dừng:</strong> @item["ThongTinQuaCanh"]
                                        </div>
                                    }
                                    <div class="small text-success fw-semibold">Còn @item["SoGheTrong"] ghế trống</div>
                                </div>
                                <div class="d-flex justify-content-between align-items-center border-top pt-3 mt-3">
                                    <div>
                                        <small class="text-muted d-block">Chi phí từ</small>
                                        <span class="fs-5 fw-bold text-primary">@Convert.ToDecimal(item["GiaVeCoBan"]).ToString("N0") VNĐ</span>
                                    </div>
                                    <div>
                                        <input type="radio" class="btn-check" name="selectedVe" id="ve_@item["MaChuyenBay"]" value="@item["MaChuyenBay"]" onchange="updateRoundTripBar()">
                                        <label class="btn btn-outline-primary fw-bold rounded-pill px-3" for="ve_@item["MaChuyenBay"]">Chọn lượt về</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- Thanh xác nhận nổi khi chọn đủ cả Lượt đi và Lượt về -->
        <div id="roundTripFooter" class="card shadow-lg border-danger p-3 sticky-bottom mb-3 d-none">
            <div class="d-flex justify-content-between align-items-center">
                <div class="fw-bold" id="roundTripSummary">Đã chọn chuyến đi và chuyến về</div>
                <a id="proceedRoundTripBtn" href="#" class="btn btn-danger btn-lg fw-bold rounded-pill px-4">
                    Tiếp tục chọn ghế khứ hồi →
                </a>
            </div>
        </div>
    }
</div>

<script>
    function toggleRoundTrip(isRound) {
        document.getElementById('loaiHanhTrinhInput').value = isRound ? 'KHU_HOI' : 'MOT_CHIEU';
        document.getElementById('ngayVeCol').style.display = isRound ? 'block' : 'none';
    }

    function updateRoundTripBar() {
        const di = document.querySelector('input[name="selectedDi"]:checked')?.value;
        const ve = document.querySelector('input[name="selectedVe"]:checked')?.value;
        const footer = document.getElementById('roundTripFooter');
        const btn = document.getElementById('proceedRoundTripBtn');

        if (di && ve && footer && btn) {
            footer.classList.remove('d-none');
            document.getElementById('roundTripSummary').innerHTML =
                `Hành trình khứ hồi: <span class="text-danger">${di}</span> (Đi) + <span class="text-primary">${ve}</span> (Về)`;
            btn.href = `/Booking/SelectSeats?maChuyenBayDi=${di}&maChuyenBayVe=${ve}&soHanhKhach=@ViewBag.SoHanhKhach`;
        }
    }
</script>