@{
    ViewData["Title"] = "Vé Của Tôi";
    var bookings = ViewBag.Bookings as List<Dictionary<string, object>> ?? new();
    var dichVus = ViewBag.DichVuBoSung as List<Dictionary<string, object>> ?? new();
}

<div class="container py-4">
    <h3 class="fw-bold mb-3">Quản lý vé đã đặt &amp; Dịch vụ bổ sung</h3>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success fw-bold">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger fw-bold">@TempData["Error"]</div>
    }

    @foreach (var b in bookings)
    {
        bool daTT = b["TrangThai"].ToString() == "Đã thanh toán";
        bool duocXuatHD = Convert.ToInt32(b["DuocXuatHoaDon72h"]) == 1;

        <div class="card shadow-sm border-0 rounded-4 mb-3 p-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <span class="badge bg-danger fs-6">@b["MaDatCho"]</span>
                    <span class="badge bg-secondary">@b["LoaiHanhTrinh"]</span>
                    <span class="badge @(daTT ? "bg-success" : "bg-warning text-dark")">@b["TrangThai"]</span>
                    <div class="mt-2 small text-muted">
                        Ngày đặt: @Convert.ToDateTime(b["NgayDat"]).ToString("dd/MM/yyyy HH:mm") •
                        Tổng tiền vé: <strong>@Convert.ToDecimal(b["TongTienSauGiam"]).ToString("N0")đ</strong> •
                        Dịch vụ mua thêm: <strong class="text-primary">@Convert.ToDecimal(b["TienDichVuThem"]).ToString("N0")đ</strong>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    @if (daTT)
                    {
                        <!-- Nút bấm vào vé đã mua để mua thêm hành lý / suất ăn / chọn ghế -->
                        <button class="btn btn-outline-primary btn-sm fw-bold" data-bs-toggle="modal" data-bs-target="#addonModal_@b["MaDatCho"]">
                            + Mua thêm dịch vụ (CK)
                        </button>

                        <!-- Chỉ cho phép xuất hóa đơn trong vòng 72 tiếng sau khi mua vé -->
                        @if (duocXuatHD)
                        {
                            <a asp-action="Invoice" asp-route-maDatCho="@b["MaDatCho"]" class="btn btn-success btn-sm fw-bold">
                                📄 Xuất hóa đơn (Trong 72h)
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-secondary btn-sm" disabled title="Đã quá 72 giờ kể từ lúc thanh toán">
                                Quá hạn 72h xuất hóa đơn
                            </button>
                        }
                    }
                    else if (b["TrangThai"].ToString() == "Chờ thanh toán")
                    {
                        <a asp-action="Payment" asp-route-maDatCho="@b["MaDatCho"]" class="btn btn-warning btn-sm fw-bold">Thanh toán ngay</a>
                    }
                </div>
            </div>
        </div>

        <!-- Modal mua thêm dịch vụ sau khi đặt vé thành công -->
        <div class="modal fade" id="addonModal_@b["MaDatCho"]" tabindex="-1">
            <div class="modal-dialog">
                <form method="post" asp-action="BuyAddonAfterBooking" class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold">Mua thêm dịch vụ cho vé @b["MaDatCho"]</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="maDatCho" value="@b["MaDatCho"]" />
                        @foreach (var dv in dichVus)
                        {
                            <div class="form-check border rounded p-2 mb-2">
                                <input class="form-check-input" type="checkbox" name="serviceIds" value="@dv["MaDV"]" id="m_@(b["MaDatCho"])_@dv["MaDV"]">
                                <label class="form-check-label w-100" for="m_@(b["MaDatCho"])_@dv["MaDV"]">
                                    <strong>@dv["TenDV"]</strong> (+@Convert.ToDecimal(dv["DonGia"]).ToString("N0")đ)
                                </label>
                            </div>
                        }
                        <div class="alert alert-info small mt-3 mb-0">
                            Hình thức thanh toán: <strong>Chuyển khoản ngân hàng (VietQR)</strong>.
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary fw-bold">Xác nhận &amp; Chuyển khoản</button>
                    </div>
                </form>
            </div>
        </div>
    }
</div>