@{
    ViewData["Title"] = "Chọn Ghế & Dịch Vụ Bổ Sung";
    var chuyenDi = ViewBag.ChuyenDi as Dictionary<string, object>;
    var gheDi = ViewBag.GheChuyenDi as List<Dictionary<string, object>> ?? new();
    var chuyenVe = ViewBag.ChuyenVe as Dictionary<string, object>;
    var gheVe = ViewBag.GheChuyenVe as List<Dictionary<string, object>>;
    var dichVus = ViewBag.DichVuBoSung as List<Dictionary<string, object>> ?? new();
    int soHK = ViewBag.SoHanhKhach ?? 1;
}

<div class="container py-4">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger fw-bold">@TempData["Error"]</div>
    }
    <div id="realtimeAlert" class="alert alert-info d-none fw-semibold"></div>

    <form method="post" asp-action="HoldSeatsAndProceed">
        <input type="hidden" name="maChuyenBayDi" value="@chuyenDi!["MaChuyenBay"]" />
        @if (chuyenVe != null)
        {
            <input type="hidden" name="maChuyenBayVe" value="@chuyenVe["MaChuyenBay"]" />
        }

        <div class="row g-4">
            <!-- SƠ ĐỒ GHẾ LƯỢT ĐI -->
            <div class="@(chuyenVe != null ? "col-md-6" : "col-md-7")">
                <div class="card shadow-sm rounded-4 p-4">
                    <h5 class="fw-bold text-danger">1. Chọn @soHK ghế Lượt đi: @chuyenDi["MaChuyenBay"] (@chuyenDi["MaSanBayDi"] → @chuyenDi["MaSanBayDen"])</h5>
                    <p class="small text-muted">Cập nhật đa luồng thời gian thực: Ghế màu xám là đã có người giữ/đặt.</p>
                    <div class="row g-2 mt-2" id="seatGrid_@chuyenDi["MaChuyenBay"]">
                        @foreach (var g in gheDi)
                        {
                            bool daDat = Convert.ToInt32(g["DaBiDat"]) == 1;
                            <div class="col-3">
                                <input type="checkbox" class="btn-check seat-chk-di" name="gheDiIds" id="seat_@g["MaGhe"]" value="@g["MaGhe"]" @(daDat ? "disabled" : "") onchange="limitCheck('.seat-chk-di', @soHK)">
                                <label class="btn @(g["MaHangGhe"].ToString() == "BUS" ? "btn-outline-warning" : "btn-outline-secondary") w-100 fw-bold" for="seat_@g["MaGhe"]">
                                    @g["SoGhe"] <small class="d-block">@g["MaHangGhe"]</small>
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- SƠ ĐỒ GHẾ LƯỢT VỀ (NẾU ĐẶT KHỨ HỒI) -->
            @if (chuyenVe != null && gheVe != null)
            {
                <div class="col-md-6">
                    <div class="card shadow-sm rounded-4 p-4">
                        <h5 class="fw-bold text-primary">2. Chọn @soHK ghế Lượt về: @chuyenVe["MaChuyenBay"] (@chuyenVe["MaSanBayDi"] → @chuyenVe["MaSanBayDen"])</h5>
                        <p class="small text-muted">Chọn đồng thời ghế cho chuyến về.</p>
                        <div class="row g-2 mt-2" id="seatGrid_@chuyenVe["MaChuyenBay"]">
                            @foreach (var g in gheVe)
                            {
                                bool daDat = Convert.ToInt32(g["DaBiDat"]) == 1;
                                <div class="col-3">
                                    <input type="checkbox" class="btn-check seat-chk-ve" name="gheVeIds" id="seat_@g["MaGhe"]" value="@g["MaGhe"]" @(daDat ? "disabled" : "") onchange="limitCheck('.seat-chk-ve', @soHK)">
                                    <label class="btn @(g["MaHangGhe"].ToString() == "BUS" ? "btn-outline-warning" : "btn-outline-secondary") w-100 fw-bold" for="seat_@g["MaGhe"]">
                                        @g["SoGhe"] <small class="d-block">@g["MaHangGhe"]</small>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- THÔNG TIN HÀNH KHÁCH + MUA THÊM DỊCH VỤ -->
            <div class="col-12">
                <div class="card shadow-sm rounded-4 p-4">
                    <h5 class="fw-bold mb-3">Thông tin hành khách &amp; Dịch vụ bổ sung (Hành lý / Suất ăn / Chọn ghế)</h5>
                    @for (int i = 0; i < soHK; i++)
                    {
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Họ tên hành khách @(i + 1) *</label>
                                <input type="text" name="tenHanhKhachs" class="form-control" required placeholder="VD: PHAM MINH HUNG" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Số CCCD / Hộ chiếu *</label>
                                <input type="text" name="cccdHanhKhachs" class="form-control" required placeholder="VD: 079206001234" />
                            </div>
                        </div>
                    }

                    <h6 class="fw-bold text-primary mt-3">Mua thêm dịch vụ đi kèm (Có thể mua thêm sau khi đặt vé):</h6>
                    <div class="row g-2 mb-3">
                        @foreach (var dv in dichVus)
                        {
                            <div class="col-md-4">
                                <div class="form-check border rounded-3 p-3">
                                    <input class="form-check-input" type="checkbox" name="selectedServiceIds" value="@dv["MaDV"]" id="dv_@dv["MaDV"]">
                                    <label class="form-check-label w-100" for="dv_@dv["MaDV"]">
                                        <strong>@dv["TenDV"]</strong>
                                        <span class="badge bg-info text-dark float-end">+@Convert.ToDecimal(dv["DonGia"]).ToString("N0")đ</span>
                                        <small class="d-block text-muted">@dv["LoaiDV"]</small>
                                    </label>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="row g-3 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Mã khuyến mãi (VD: HE2026, VIPBAY)</label>
                            <input type="text" name="maKM" class="form-control" placeholder="Nhập mã giảm giá..." />
                        </div>
                        <div class="col-md-8 text-end">
                            <button type="submit" class="btn btn-danger btn-lg fw-bold px-5">Giữ ghế 15 phút &amp; Thanh toán Online →</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script>
    function limitCheck(selector, max) {
        const checked = document.querySelectorAll(selector + ':checked');
        if (checked.length > max) {
            checked[0].checked = false;
        }
    }

    // Kết nối SignalR đồng bộ sơ đồ ghế giữa các trình duyệt (Chrome, Edge...) theo thời gian thực
    const connection = new signalR.HubConnectionBuilder().withUrl("/seatHub").build();

    connection.on("SeatStatusChanged", function (data) {
        data.seatIds.forEach(id => {
            const chk = document.getElementById("seat_" + id);
            if (chk) {
                if (data.isOccupied) {
                    chk.checked = false;
                    chk.disabled = true;
                } else {
                    chk.disabled = false;
                }
            }
        });
        const alertBox = document.getElementById("realtimeAlert");
        alertBox.textContent = data.message || "Sơ đồ ghế vừa được cập nhật theo thời gian thực từ giao dịch khác!";
        alertBox.classList.remove("d-none");
    });

    connection.start().then(() => {
        connection.invoke("JoinFlightRoom", "@chuyenDi["MaChuyenBay"]");
        @if (chuyenVe != null)
        {
                <text>connection.invoke("JoinFlightRoom", "@chuyenVe["MaChuyenBay"]");</text>
        }
    });
</script>