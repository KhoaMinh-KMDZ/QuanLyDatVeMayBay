@using System.Data
@{
    ViewData["Title"] = "Chọn ghế ngồi & Thông tin hành khách";
    var cb = ViewBag.ChuyenBay as DataRow;
    var dtGhe = ViewBag.DanhSachGhe as DataTable;
    var kms = ViewBag.KhuyenMais as DataTable;
    string defaultName = Context.Session.GetString("UserType") == "KH" ? (Context.Session.GetString("UserName") ?? "") : "";
    string defaultCCCD = Context.Session.GetString("UserType") == "KH" ? (Context.Session.GetString("UserCCCD") ?? "") : "";
}

<div class="container my-5">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <!-- Thanh tóm tắt chuyến bay -->
    <div class="card card-modern p-4 mb-4 bg-dark text-white">
        <div class="row align-items-center">
            <div class="col-md-8">
                <span class="badge bg-warning text-dark me-2">@cb!["MaChuyenBay"]</span>
                <span class="fw-bold fs-5">@cb["ThanhPhoDi"] (@cb["MaSanBayDi"]) <i class="bi bi-arrow-right mx-2 text-info"></i> @cb["ThanhPhoDen"] (@cb["MaSanBayDen"])</span>
                <div class="small text-light opacity-75 mt-1">
                    Hãng: <strong>@cb["TenHangHangKhong"]</strong> • Tàu bay: <strong>@cb["TenMayBay"]</strong> • Khởi hành: <strong>@Convert.ToDateTime(cb["NgayGioBay"]).ToString("HH:mm dd/MM/yyyy")</strong>
                </div>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <div class="small opacity-75">Giá cơ bản (Phổ thông)</div>
                <div class="fs-4 fw-bold text-warning">@Convert.ToDecimal(cb["GiaVeCoBan"]).ToString("N0") VNĐ</div>
            </div>
        </div>
    </div>

    <form method="post" asp-action="CreateBooking" id="bookingForm">
        @if (Context.Session.GetString("UserType") == "NV" && Context.Session.GetInt32("RoleID") == 3)
        {
            <label for="maKhachTaiQuay" class="form-label">Mã khách hàng đã có hồ sơ</label>
            <input id="maKhachTaiQuay" name="maKhachTaiQuay" class="form-control mb-3" maxlength="10" required />
        }
        else if (Context.Session.GetString("UserType") != "KH")
        {
            <p class="alert alert-info">Đăng nhập tài khoản khách hàng trước khi xác nhận giữ chỗ.
                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">Đăng nhập</a>
            </p>
        }
        <input type="hidden" name="maChuyenBay" value="@cb["MaChuyenBay"]" />

        <div class="row g-4">
            <!-- CỘT TRÁI: SƠ ĐỒ KHOANG GHẾ MÁY BAY -->
            <div class="col-lg-5">
                <div class="card card-modern p-4">
                    <h5 class="fw-bold mb-3"><i class="bi bi-grid-3x3-gap-fill text-primary me-2"></i>Sơ đồ khoang ghế (@cb["MaMayBay"])</h5>

                    <!-- Chú thích màu -->
                    <div class="d-flex flex-wrap gap-3 small mb-4 pb-3 border-bottom">
                        <span><span class="badge bg-warning text-dark">&nbsp;&nbsp;</span> Thương gia (x2.0)</span>
                        <span><span class="badge bg-outline-primary border border-primary text-primary">&nbsp;&nbsp;</span> Phổ thông (x1.0)</span>
                        <span><span class="badge bg-success">&nbsp;&nbsp;</span> Đang chọn</span>
                        <span><span class="badge bg-secondary">&nbsp;&nbsp;</span> Đã đặt</span>
                    </div>

                    <!-- Mũi máy bay -->
                    <div class="text-center mb-3">
                        <div class="mx-auto bg-light border rounded-top-pill py-2 fw-semibold text-muted small" style="width: 220px;">
                            <i class="bi bi-chevron-up d-block"></i>KHOANG LÁI (MŨI TÀU BAY)
                        </div>
                    </div>

                    <!-- Lưới ghế ngồi -->
                    <div class="mx-auto" style="max-width: 290px;">
                        <div class="row g-2 text-center">
                            @if (dtGhe != null)
                            {
                                foreach (DataRow g in dtGhe.Rows)
                                {
                                    int maGhe = Convert.ToInt32(g["MaGhe"]);
                                    string soGhe = g["SoGhe"].ToString()!;
                                    string hang = g["MaHangGhe"].ToString()!;
                                    string tinhTrang = g["TinhTrang"].ToString()!;
                                    decimal giaThucTe = Convert.ToDecimal(g["GiaThucTe"]);

                                    bool isBooked = tinhTrang != "Trống";
                                    string btnClass = isBooked
                                    ? "btn-secondary disabled opacity-50"
                                    : (hang == "BUS" ? "btn-outline-warning text-dark fw-bold" : "btn-outline-primary fw-semibold");

                                    <div class="col-3">
                                        <button type="button"
                                                class="btn @btnClass w-100 py-2 seat-btn"
                                                data-maghe="@maGhe"
                                                data-soghe="@soGhe"
                                                data-hang="@hang"
                                                aria-pressed="false"
                                                data-gia="@giaThucTe.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                @(isBooked ? "disabled" : "")>
                                            @soGhe
                                        </button>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- CỘT PHẢI: THÔNG TIN HÀNH KHÁCH & DỊCH VỤ PHỤ TRỢ -->
            <div class="col-lg-7">
                <div class="card card-modern p-4">
                    <h5 class="fw-bold mb-3"><i class="bi bi-people-fill text-primary me-2"></i>Hồ sơ hành khách & Dịch vụ đi kèm</h5>

                    <div id="passengerContainer">
                        <div class="alert alert-info small mb-0" id="emptySeatAlert">
                            <i class="bi bi-hand-index-thumb me-1"></i>Hãy nhấp chọn vị trí ghế trống trên sơ đồ bên trái để nhập thông tin hành khách.
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold small">Ghi chú đơn đặt chỗ</label>
                            <input type="text" name="ghiChuThem" maxlength="200" class="form-control" placeholder="Yêu cầu hỗ trợ đặc biệt (nếu có)..." />
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center bg-light p-3 rounded-3 mt-4">
                        <div>
                            <div class="small text-muted">Tạm tính giá vé và phụ phí (<span id="seatCount">0</span> ghế)</div>
                            <div class="fs-4 fw-bold text-danger" id="totalPrice">0 VNĐ</div>
                        </div>
                        <button type="submit" class="btn btn-sky btn-lg px-4 rounded-pill">
                            Khóa ghế & Nhận mã PNR <i class="bi bi-lock-fill ms-1"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<template id="passengerTemplate">
<div class="border rounded-3 p-3 mb-3 bg-white" data-passenger-seat>
    <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="badge bg-success" data-seat-description></span>
        <span class="fw-bold text-primary" data-seat-price></span>
    </div>
    <input type="hidden" name="selectedMaGhe" />
    <div class="row g-2">
        <div class="col-md-5">
            <input type="text" name="tenHanhKhach" aria-label="Họ tên hành khách" class="form-control form-control-sm" placeholder="Họ tên hành khách *" maxlength="50" required />
        </div>
        <div class="col-md-4">
            <input type="text" name="cccdHanhKhach" aria-label="CCCD hoặc hộ chiếu" class="form-control form-control-sm" placeholder="CCCD / Hộ chiếu *" maxlength="30" required />
        </div>
        <div class="col-md-3">
            <select name="loaiHanhKhach" aria-label="Loại hành khách" class="form-select form-select-sm">
                <option value="Người lớn">Người lớn</option>
                <option value="Trẻ em">Trẻ em</option>
                <option value="Em bé">Em bé</option>
            </select>
        </div>
        <div class="col-12">
            <label class="form-label small">Dịch vụ phụ trợ</label>
            <select name="dichVuPhuTro" aria-label="Dịch vụ phụ trợ" class="form-select form-select-sm">
                <option value="">Không chọn thêm</option>
            </select>
        </div>
    </div>
</div>
</template>

@section Scripts {
    <script>
        const selectedSeats = new Map();
        const services = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            ((DataTable)ViewBag.DichVu).AsEnumerable().Select(row => new {
                code = row.Field<string>("MaDichVu"),
                name = row.Field<string>("TenDichVu"),
                price = row.Field<decimal>("DonGia")
            })));
        const defaultName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(defaultName));
        const defaultCCCD = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(defaultCCCD));

        const passengerContainer = document.getElementById('passengerContainer');
        const passengerTemplate = document.getElementById('passengerTemplate');

        document.querySelectorAll('.seat-btn:not(:disabled)').forEach(button => {
            button.addEventListener('click', () => {
                const { maghe: seatId, soghe, hang, gia } = button.dataset;
                const price = Number(gia);
                const selected = selectedSeats.get(seatId);
                const regularColour = hang === 'BUS' ? 'btn-outline-warning' : 'btn-outline-primary';

                if (selected) {
                    selected.card.remove();
                    selectedSeats.delete(seatId);
                } else {
                    const card = passengerTemplate.content.firstElementChild.cloneNode(true);
                    card.dataset.passengerSeat = seatId;
                    card.querySelector('[data-seat-description]').textContent = `Ghế ${soghe} (${hang})`;
                    card.querySelector('[data-seat-price]').textContent = price.toLocaleString('vi-VN') + ' VNĐ';
                    card.querySelector('[name=selectedMaGhe]').value = seatId;
                    if (selectedSeats.size === 0) {
                        card.querySelector('[name=tenHanhKhach]').value = defaultName;
                        card.querySelector('[name=cccdHanhKhach]').value = defaultCCCD;
                    }
                    const service = card.querySelector('[name=dichVuPhuTro]');
                    services.forEach(item => service.add(new Option(
                        item.name + ' (' + item.price.toLocaleString('vi-VN') + ' VNĐ)', item.code)));
                    service.addEventListener('change', updatePrice);
                    passengerContainer.append(card);
                    selectedSeats.set(seatId, { card, price });
                }

                button.classList.toggle(regularColour, Boolean(selected));
                button.classList.toggle('btn-success', !selected);
                button.classList.toggle('text-white', !selected);
                if (hang === 'BUS') button.classList.toggle('text-dark', Boolean(selected));
                button.setAttribute('aria-pressed', String(!selected));
                document.getElementById('emptySeatAlert').hidden = selectedSeats.size > 0;
                document.getElementById('seatCount').textContent = selectedSeats.size;
                updatePrice();
            });
        });

        function updatePrice() {
            let total = 0;
            selectedSeats.forEach(({ card, price }) => {
                const serviceCode = card.querySelector('[name=dichVuPhuTro]').value;
                total += price + (services.find(item => item.code === serviceCode)?.price ?? 0);
            });
            document.getElementById('totalPrice').textContent = total.toLocaleString('vi-VN') + ' VNĐ';
        }
    </script>
}
