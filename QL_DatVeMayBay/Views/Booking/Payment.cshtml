@{
    ViewData["Title"] = "Thanh Toán Online";
    var donDi = ViewBag.DonDi as Dictionary<string, object>;
    var donVe = ViewBag.DonVe as Dictionary<string, object>;
    decimal tongTien = ViewBag.TongThanhToan;
    DateTime hanTT = Convert.ToDateTime(donDi!["HanThanhToan"]);
}

<div class="container py-5" style="max-width: 720px;">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
        <div class="card-header bg-dark text-white p-4 d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-0 fw-bold">THANH TOÁN ĐẶT VÉ TRỰC TUYẾN</h5>
                <small>Mã đặt chỗ: <strong class="text-warning">@donDi["MaDatCho"]</strong> @(donVe != null ? $" & {donVe["MaDatCho"]} (Khứ hồi)" : "")</small>
            </div>
            <div class="badge bg-danger fs-6 px-3 py-2" id="countdownBadge">⏳ 15:00</div>
        </div>

        <form method="post" asp-action="ConfirmOnlinePayment" class="card-body p-4">
            <input type="hidden" name="maDatCho" value="@donDi["MaDatCho"]" />
            @if (donVe != null)
            {
                <input type="hidden" name="maDatChoVe" value="@donVe["MaDatCho"]" />
            }

            <div class="alert alert-warning small">
                Nếu quá <strong>15 phút</strong> chưa hoàn tất chuyển khoản, giao dịch sẽ tự động hủy và trả ghế về trạng thái trống cho hành khách khác.
            </div>

            <div class="p-3 bg-light rounded-3 mb-4 d-flex justify-content-between align-items-center">
                <span class="fw-bold">Tổng thanh toán (Vé + Dịch vụ):</span>
                <span class="fs-4 fw-bold text-danger">@tongTien.ToString("N0") VNĐ</span>
            </div>

            <label class="form-label fw-bold">Chọn hình thức thanh toán Online:</label>
            <select name="phuongThuc" class="form-select form-select-lg mb-4" id="payMethodSelect" onchange="toggleQR(this.value)">
                <option value="Chuyển khoản ngân hàng (VietQR)">Chuyển khoản ngân hàng (Quét mã VietQR)</option>
                <option value="Ví MoMo">Ví điện tử MoMo</option>
                <option value="Ví ZaloPay">Ví điện tử ZaloPay</option>
                <option value="Thẻ ATM nội địa">Thẻ ATM nội địa / Internet Banking</option>
                <option value="VISA/MasterCard">Thẻ quốc tế VISA / MasterCard</option>
            </select>

            <div id="vietQrBox" class="text-center border rounded-4 p-3 mb-4 bg-white">
                <p class="fw-bold mb-2">Quét mã VietQR để chuyển khoản nhanh</p>
                <img src="https://img.vietqr.io/image/MB-0901234567-compact2.png?amount=@((long)tongTien)&addInfo=@donDi["MaDatCho"]" alt="VietQR" style="max-width:220px;" />
                <div class="small text-muted mt-2">Nội dung CK: <strong>@donDi["MaDatCho"]</strong></div>
            </div>

            <button type="submit" class="btn btn-success btn-lg w-100 fw-bold">✔ Tôi đã thanh toán chuyển khoản</button>
        </form>
    </div>
</div>

<script>
    function toggleQR(val) {
        document.getElementById('vietQrBox').style.display = val.includes('VietQR') ? 'block' : 'none';
    }

    const expireTime = new Date("@hanTT.ToString("yyyy-MM-ddTHH:mm:ss")").getTime();
    setInterval(() => {
        const diff = Math.floor((expireTime - Date.now()) / 1000);
        if (diff <= 0) {
            alert("Đã hết 15 phút giữ ghế! Giao dịch đã tự động hủy và nhả ghế.");
            window.location.href = "/Home/Index";
            return;
        }
        const m = String(Math.floor(diff / 60)).padStart(2, '0');
        const s = String(diff % 60).padStart(2, '0');
        document.getElementById('countdownBadge').textContent = `⏳ ${m}:${s}`;
    }, 1000);
</script>