@using System.Data
@{
    ViewData["Title"] = "Thanh toán đơn đặt chỗ";
    var don = ViewBag.DonDatCho as DataRow;
    var ves = ViewBag.DanhSachVe as DataTable;
    decimal tongSauGiam = Convert.ToDecimal(don!["TongTienSauGiam"]);
}

<div class="container my-5">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card card-modern p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                    <div>
                        <span class="badge bg-warning text-dark mb-1">ĐANG GIỮ CHỖ AN TOÀN</span>
                        <h4 class="fw-bold mb-0">Mã đặt chỗ (PNR): <span class="text-primary">@don["MaDatCho"]</span></h4>
                    </div>
                    <div class="text-end small">
                        <div class="text-muted">Hạn thanh toán</div>
                        <div class="fw-bold text-danger">@Convert.ToDateTime(don["HanThanhToan"]).ToString("HH:mm dd/MM/yyyy")</div>
                    </div>
                </div>

                <!-- Chi tiết vé giữ chỗ -->
                <h6 class="fw-bold mb-2">Danh sách vé trong hồ sơ</h6>
                <div class="table-responsive mb-4">
                    <table class="table table-sm table-bordered align-middle small">
                        <thead class="table-light">
                            <tr>
                                <th>Mã vé</th>
                                <th>Hành khách</th>
                                <th>Chuyến bay</th>
                                <th>Ghế / Hạng</th>
                                <th class="text-end">Giá vé</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ves != null)
                            {
                                foreach (DataRow v in ves.Rows)
                                {
                                    <tr>
                                        <td class="fw-semibold">@v["MaVe"]</td>
                                        <td>@v["TenHanhKhach"]</td>
                                        <td>@v["MaChuyenBay"] (@v["ThanhPhoDi"] → @v["ThanhPhoDen"])</td>
                                        <td><span class="badge bg-primary">@v["SoGhe"]</span> @v["TenHangGhe"]</td>
                                        <td class="text-end">@Convert.ToDecimal(v["GiaVe"]).ToString("N0")đ</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Bảng tổng tiền -->
                <div class="bg-light p-3 rounded-3 mb-4">
                    <div class="d-flex justify-content-between small mb-1">
                        <span>Tổng tiền vé gốc:</span>
                        <span>@Convert.ToDecimal(don["TongTienGoc"]).ToString("N0") VNĐ</span>
                    </div>
                    <div class="d-flex justify-content-between small text-success mb-2">
                        <span>Chiết khấu Voucher:</span>
                        <span>- @Convert.ToDecimal(don["TienGiam"]).ToString("N0") VNĐ</span>
                    </div>
                    <div class="d-flex justify-content-between fs-5 fw-bold text-danger border-top pt-2">
                        <span>TỔNG THANH TOÁN (ĐÃ GỒM VAT):</span>
                        <span>@tongSauGiam.ToString("N0") VNĐ</span>
                    </div>
                </div>

                <!-- Form chọn cổng thanh toán -->
                <form method="post" asp-action="ConfirmPayment">
                    <input type="hidden" name="maDatCho" value="@don["MaDatCho"]" />

                    <div class="row g-3 align-items-center">
                        <div class="col-md-7">
                            <label class="form-label fw-semibold small">Chọn kênh thanh toán (UC04)</label>
                            <select name="phuongThuc" class="form-select mb-3">
                                <option value="Ví MoMo">Ví điện tử MoMo (QR Pay)</option>
                                <option value="Ví ZaloPay">Ví điện tử ZaloPay</option>
                                <option value="Thẻ ATM nội địa">Thẻ ATM nội địa / Napas</option>
                                <option value="VISA/MasterCard">Thẻ quốc tế VISA / MasterCard</option>
                                <option value="Tiền mặt">Tiền mặt tại quầy đại lý</option>
                            </select>
                            <button type="submit" class="btn btn-success btn-lg w-100 rounded-pill fw-semibold">
                                <i class="bi bi-check-circle-fill me-2"></i>Xác nhận thanh toán & Xuất vé
                            </button>
                        </div>
                        <div class="col-md-5 text-center">
                            <div class="border rounded-3 p-3 bg-white">
                                <img src="https://api.qrserver.com/v1/create-qr-code/?size=140x140&data=SKYVN_@don["MaDatCho"]_@tongSauGiam" alt="QR Thanh Toán" class="img-fluid mb-2" />
                                <div class="small text-muted">Quét mã QR để đối soát giao dịch</div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>