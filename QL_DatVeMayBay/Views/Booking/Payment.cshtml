@using System.Data
@{
    ViewData["Title"] = "Thanh toán đơn đặt chỗ";
    var don = ViewBag.DonDatCho as DataRow;
    var ves = ViewBag.DanhSachVe as DataTable;
    var vouchers = (DataTable)ViewBag.Vouchers;
    bool allowDemo = ViewBag.AllowDemoPayments == true;
    bool allowCash = Context.Session.GetInt32("RoleID") is 1 or 2;
    decimal tongSauGiam = Convert.ToDecimal(don!["TongTienSauGiam"]);
}

<div class="container my-5">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card card-modern p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                    <div>
                        <span class="badge bg-warning text-dark mb-1">ĐANG GIỮ CHỖ AN TOÀN</span>
                        <h4 class="fw-bold mb-0">Mã đặt chỗ (PNR): <span class="text-primary">@don["MaDatCho"]</span></h4>
                    </div>
                    <div class="text-end small">
                        <div class="text-muted">Hạn giữ chỗ</div>
                        <div id="holdCountdown" class="fs-4 fw-bold text-danger"
                             data-seconds="@don["SoGiayGiuCho"]" role="timer"></div>
                        <div class="fw-bold text-danger">@Convert.ToDateTime(don["HanThanhToan"]).ToString("HH:mm dd/MM/yyyy")</div>
                    </div>
                </div>

                <!-- Chi tiết vé giữ chỗ -->
                <h6 class="fw-bold mb-2">Danh sách vé trong hồ sơ</h6>
                <div class="table-responsive mb-4">
                    <table class="table table-sm table-bordered align-middle small">
                        <thead class="table-light">
                            <tr>
                                <th>Mã vé</th>
                                <th>Hành khách</th>
                                <th>Chuyến bay</th>
                                <th>Ghế / Hạng</th>
                                <th class="text-end">Giá vé</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ves != null)
                            {
                                foreach (DataRow v in ves.Rows)
                                {
                                    <tr>
                                        <td class="fw-semibold">@v["MaVe"]</td>
                                        <td>@v["TenHanhKhach"]</td>
                                        <td>@v["MaChuyenBay"] (@v["ThanhPhoDi"] → @v["ThanhPhoDen"])</td>
                                        <td><span class="badge bg-primary">@v["SoGhe"]</span> @v["TenHangGhe"]</td>
                                        <td class="text-end">@((Convert.ToDecimal(v["GiaVe"]) + Convert.ToDecimal(v["PhiPhuTro"])).ToString("N0"))đ</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <form method="post" asp-action="ApplyVoucher" class="mb-3" data-hold-action>
                    <input type="hidden" name="maDatCho" value="@don["MaDatCho"]" />
                    <label for="maKM" class="form-label">Voucher
                        @if (don["MaKM"] != DBNull.Value)
                        {
                            <span class="text-success">đang áp dụng @don["MaKM"]</span>
                        }
                    </label>
                    <div class="input-group">
                        <input id="maKM" name="maKM" maxlength="20" list="voucherOptions" class="form-control" placeholder="Nhập mã hoặc để trống để bỏ mã" />
                        <button class="btn btn-outline-primary">Cập nhật voucher</button>
                    </div>
                    <datalist id="voucherOptions">
                        @foreach (DataRow voucher in vouchers.Rows)
                        {
                            <option value="@voucher["MaKM"]">@voucher["TenKM"]</option>
                        }
                    </datalist>
                </form>

                <!-- Bảng tổng tiền -->
                <div class="bg-light p-3 rounded-3 mb-4">
                    <div class="d-flex justify-content-between small mb-1">
                        <span>Tiền vé và phụ phí:</span>
                        <span>@Convert.ToDecimal(don["TongTienGoc"]).ToString("N0") VNĐ</span>
                    </div>
                    <div class="d-flex justify-content-between small text-success mb-2">
                        <span>Chiết khấu Voucher:</span>
                        <span>- @Convert.ToDecimal(don["TienGiam"]).ToString("N0") VNĐ</span>
                    </div>
                    <div class="d-flex justify-content-between fs-5 fw-bold text-danger border-top pt-2">
                        <span>TỔNG THANH TOÁN:</span>
                        <span>@tongSauGiam.ToString("N0") VNĐ</span>
                    </div>
                </div>

                @if (allowDemo || allowCash)
                {
                    <form method="post" asp-action="ConfirmPayment" data-hold-action>
                        <input type="hidden" name="maDatCho" value="@don["MaDatCho"]" />
                        <label for="phuongThuc" class="form-label fw-semibold">Phương thức thanh toán</label>
                        <select id="phuongThuc" name="phuongThuc" class="form-select mb-3">
                            @if (allowCash)
                            {
                                <option value="Tiền mặt">Tiền mặt tại quầy</option>
                            }
                            @if (allowDemo)
                            {
                                <option value="Ví MoMo">MoMo (mô phỏng)</option>
                                <option value="Ví ZaloPay">ZaloPay (mô phỏng)</option>
                                <option value="Thẻ ATM nội địa">Thẻ ATM nội địa (mô phỏng)</option>
                                <option value="VISA/MasterCard">VISA / MasterCard (mô phỏng)</option>
                                <option value="Internet Banking">Internet Banking (mô phỏng)</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-success">Xác nhận thanh toán và xuất vé</button>
                    </form>
                }
                else
                {
                    <p class="alert alert-info mb-0">Liên hệ quầy thu ngân để thanh toán đơn giữ chỗ.</p>
                }
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        const countdown = document.getElementById('holdCountdown');
        const expiresAt = performance.now() + Number(countdown.dataset.seconds) * 1000;
        const format = value => String(value).padStart(2, '0');

        function displayHoldTime() {
            const seconds = Math.max(0, Math.ceil((expiresAt - performance.now()) / 1000));
            countdown.textContent = seconds ? format(Math.floor(seconds / 60)) + ':' + format(seconds % 60) : 'Đã hết hạn';
            if (!seconds) {
                document.querySelectorAll('[data-hold-action] button').forEach(button => button.disabled = true);
                return;
            }
            window.setTimeout(displayHoldTime, 250);
        }

        displayHoldTime();
    </script>
}
