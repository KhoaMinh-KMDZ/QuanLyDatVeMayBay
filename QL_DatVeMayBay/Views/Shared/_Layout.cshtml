@using Microsoft.AspNetCore.Http
@{
    var userType = Context.Session.GetString("UserType"); // "KH" hoặc "NV"
    var userName = Context.Session.GetString("UserName");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SkyVN Airlines Booking</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        :root {
            --navy-primary: #0f172a;
            --sky-accent: #0284c7;
            --sky-light: #e0f2fe;
            --gold-accent: #f59e0b;
        }

        body {
            font-family: 'Be Vietnam Pro', sans-serif;
            background-color: #f1f5f9;
            color: #1e293b;
        }

        .navbar-aviation {
            background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);
            box-shadow: 0 4px 14px rgba(15, 23, 42, 0.18);
        }

        .navbar-brand {
            font-weight: 700;
            letter-spacing: -0.5px;
        }

        .btn-sky {
            background-color: var(--sky-accent);
            color: #fff;
            border: none;
            font-weight: 600;
            transition: all 0.2s;
        }

            .btn-sky:hover {
                background-color: #0369a1;
                color: #fff;
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(2, 132, 199, 0.3);
            }

        .card-modern {
            border: none;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .kpi-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(15, 23, 42, 0.1);
        }

        @@media print {
            .no-print, header, footer {
                display: none !important;
            }

            body {
                background: #fff !important;
            }

            .card-modern {
                box-shadow: none !important;
                border: 1px solid #cbd5e1 !important;
            }
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="no-print">
        <nav class="navbar navbar-expand-lg navbar-dark navbar-aviation py-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-airplane-engines-fill text-warning fs-4"></i>
                    <span>SkyVN <span class="text-info">Airlines</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-search me-1"></i>Tìm chuyến bay</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="CheckIn" asp-action="Index"><i class="bi bi-qr-code-scan me-1"></i>Check-in Online</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Booking" asp-action="Lookup"><i class="bi bi-ticket-perforated me-1"></i>Tra cứu PNR</a>
                        </li>
                        @if (userType == "KH" || (userType == "NV" && Context.Session.GetInt32("RoleID") is 1 or 4))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Support" asp-action="Index">Khiếu nại</a></li>
                        }
                        @if (userType == "KH")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-info fw-semibold" asp-controller="Booking" asp-action="MyBookings">
                                    <i class="bi bi-briefcase-fill me-1"></i>Chuyến bay của tôi
                                </a>
                            </li>
                        }
                        @if (userType == "NV")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-semibold" asp-controller="Admin" asp-action="Dashboard">
                                    <i class="bi bi-speedometer2 me-1"></i>Trung tâm Điều hành
                                </a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        @if (string.IsNullOrEmpty(userName))
                        {
                            <a class="btn btn-outline-light btn-sm px-3 rounded-pill" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-person-circle me-1"></i>Đăng nhập
                            </a>
                            <a class="btn btn-warning btn-sm px-3 rounded-pill fw-semibold" asp-controller="Account" asp-action="Register">
                                Đăng ký
                            </a>
                        }
                        else
                        {
                            <span class="text-light small me-2">
                                <i class="bi bi-person-check-fill text-warning me-1"></i><strong>@userName</strong>
                            </span>
                            <form method="post" asp-controller="Account" asp-action="Logout" class="m-0"><button type="submit" class="btn btn-outline-danger btn-sm rounded-pill">Đăng xuất</button></form>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="bg-dark text-secondary py-4 mt-5 no-print">
        <div class="container text-center small">
            <p class="mb-1 text-light fw-semibold">Hệ Thống Quản Lý Đặt Vé Máy Bay Nội Địa Việt Nam — SkyVN Airlines</p>
            <p class="mb-0">Đồ án Phân tích Thiết kế Hệ thống Thông tin - Nhóm 10 (HUIT) &copy; 2026</p>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>